# Frontend environment variables
# Copy to frontend/.env or configure these in the hosting environment.
# NEXT_PUBLIC_* variables are bundled into the browser, so do not put private secrets here.

# Backend API base URL.
# Local example:
NEXT_PUBLIC_API_URL=http://localhost:3001

# Required for browser password recovery. This is the public Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://example-supabase-project-url.invalid

# Required for browser password recovery. Use only a publishable key; never a secret or service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
